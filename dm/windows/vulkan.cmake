# Vulkan 头文件与本机 ARM64 loader；不误链接 x64 SDK 的导入库。
# Vulkan headers and the native ARM64 loader; never accidentally link the x64 SDK import library.
find_path(Vulkan_INCLUDE_DIR vulkan/vulkan.h HINTS "${VULKAN_HEADERS}/include" "$ENV{VULKAN_SDK}/Include")
if(NOT Vulkan_INCLUDE_DIR)
  message(FATAL_ERROR "Vulkan headers missing: set VULKAN_HEADERS to Khronos Vulkan-Headers, or set Vulkan_INCLUDE_DIR")
endif()
if(NOT Vulkan_LIBRARY)
  find_program(DM_GENDEF gendef HINTS "${LLVM_MINGW}/bin" REQUIRED)
  find_program(DM_DLLTOOL aarch64-w64-mingw32-dlltool HINTS "${LLVM_MINGW}/bin" REQUIRED)
  set(DM_VULKAN_DLL "$ENV{SystemRoot}/System32/vulkan-1.dll" CACHE FILEPATH "Native ARM64 Vulkan loader")
  if(NOT EXISTS "${DM_VULKAN_DLL}")
    message(FATAL_ERROR "Install an ARM64 Vulkan GPU driver, or supply an ARM64 Vulkan_LIBRARY")
  endif()
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/tools/check_arm64.py" "${DM_VULKAN_DLL}" RESULT_VARIABLE architecture)
  if(NOT architecture EQUAL 0)
    message(FATAL_ERROR "The Vulkan loader must be a native ARM64 PE image")
  endif()
  execute_process(COMMAND "${DM_GENDEF}" - "${DM_VULKAN_DLL}"
    OUTPUT_FILE "${CMAKE_CURRENT_BINARY_DIR}/vulkan-1.def" RESULT_VARIABLE exports)
  if(NOT exports EQUAL 0)
    message(FATAL_ERROR "Cannot read Vulkan loader exports")
  endif()
  execute_process(COMMAND "${DM_DLLTOOL}" -d "${CMAKE_CURRENT_BINARY_DIR}/vulkan-1.def"
    -l "${CMAKE_CURRENT_BINARY_DIR}/libvulkan-1.a" RESULT_VARIABLE imported)
  if(NOT imported EQUAL 0)
    message(FATAL_ERROR "Cannot create ARM64 Vulkan import library")
  endif()
  set(Vulkan_LIBRARY "${CMAKE_CURRENT_BINARY_DIR}/libvulkan-1.a")
endif()
add_library(Vulkan::Vulkan UNKNOWN IMPORTED)
set_target_properties(Vulkan::Vulkan PROPERTIES IMPORTED_LOCATION "${Vulkan_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${Vulkan_INCLUDE_DIR}")
