<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <AssemblyName>Dmsh.Browser.Spike</AssemblyName>
    <!-- 外层运行时清单保留源码修订；无关仓库提交不再改变程序集的信息版本。 -->
    <!-- The outer runtime manifest retains source provenance; unrelated commits do not alter the assembly informational version. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 仅此项目禁用远程源码映射，保留可移植调试符号与外层清单中的真实源码修订。 -->
    <!-- Disable remote source mappings only here; retain portable debug symbols and real source provenance in the outer manifest. -->
    <EnableSourceLink>false</EnableSourceLink>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <WasmEnableHotReload>false</WasmEnableHotReload>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RyuSrc>$(MSBuildThisFileDirectory)../../../dm/third_party/ryujinx/src</RyuSrc>
  </PropertyGroup>
  <!-- Source links deliberately bypass desktop Common project/NuGet closure. -->
  <ItemGroup>
    <Compile Include="ShaderBridge.cs;EmbeddedResources.cs" />
    <Compile Include="$(RyuSrc)/Ryujinx.Graphics.Shader/**/*.cs" Exclude="$(RyuSrc)/Ryujinx.Graphics.Shader/**/obj/**;$(RyuSrc)/Ryujinx.Graphics.Shader/**/bin/**" />
    <Compile Include="$(RyuSrc)/Spv.Generator/**/*.cs" Exclude="$(RyuSrc)/Spv.Generator/**/obj/**;$(RyuSrc)/Spv.Generator/**/bin/**" />
    <Compile Include="$(RyuSrc)/Ryujinx.Common/Pools/ObjectPool.cs;$(RyuSrc)/Ryujinx.Common/Memory/IArray.cs;$(RyuSrc)/Ryujinx.Common/Memory/StructArrayHelpers.cs;$(RyuSrc)/Ryujinx.Common/Utilities/BitUtils.cs;$(RyuSrc)/Ryujinx.Common/Utilities/BitfieldExtensions.cs" />
    <EmbeddedResource Include="$(RyuSrc)/Ryujinx.Graphics.Shader/CodeGen/Glsl/HelperFunctions/*.glsl" LogicalName="Ryujinx.Graphics.Shader.CodeGen.Glsl.HelperFunctions.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
